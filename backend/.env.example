# Copier ce fichier en .env et renseigner les valeurs.
# cp backend/.env.example backend/.env

# ── Base de données ────────────────────────────────
DATABASE_URL=postgresql://postgres:password@localhost:5435/qualisite

# ── Serveur ────────────────────────────────────────
PORT=3001
ALLOWED_ORIGINS=http://localhost:3000

# ── Auth (JWT) ─────────────────────────────────────
# Chaîne longue et aléatoire (ex: openssl rand -hex 64)
JWT_SECRET=
JWT_ACCESS_EXPIRES_IN=900
JWT_REFRESH_EXPIRES_IN=604800

# ── Email (Resend) ─────────────────────────────────
RESEND_API_KEY=
RESEND_EMAIL=contact@qualisite.fr

# ── Uploads ────────────────────────────────────────
UPLOAD_URL=http://localhost:3001/uploads

# ── Seed (npm run db:seed) ─────────────────────────
SEED_ADMIN_EMAIL=admin@qualisite.fr
SEED_ADMIN_PASSWORD=ChangeMe1234!
