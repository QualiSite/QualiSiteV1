generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ── Énumérations ──────────────────────────────────

enum UserRole {
  ADMIN
  CLIENT
}

enum ContactStatus {
  NOUVEAU
  TRAITE
  ARCHIVE
  CLIENT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PAID
  OVERDUE
}

// ── Modèles ───────────────────────────────────────

model User {
  id           String    @id @default(uuid()) @db.Uuid
  email        String    @unique
  passwordHash String    @map("password_hash")
  role         UserRole
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  deletedAt    DateTime? @map("deleted_at")

  projects Project[]
  client   Client?

  @@map("user")
}

model Project {
  id          String    @id @default(uuid()) @db.Uuid
  createdBy   String    @db.Uuid @map("created_by")
  title       String
  summary     String?
  year        Int?
  isPublished Boolean   @default(false) @map("is_published")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  deletedAt   DateTime? @map("deleted_at")

  user     User             @relation(fields: [createdBy], references: [id])
  images   ProjectImage[]
  services ProjectService[]

  @@map("project")
}

model Service {
  id          String    @id @default(uuid()) @db.Uuid
  title       String
  description String?
  iconUrl     String?   @map("icon_url")
  price       Decimal   @db.Decimal(10, 2)
  order       Int       @default(0)
  isActive    Boolean   @default(true) @map("is_active")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  projects     ProjectService[]
  requestedBy  RequestService[]
  invoiceItems InvoiceItem[]

  @@map("service")
}

model Contact {
  id             String        @id @default(uuid()) @db.Uuid
  name           String
  email          String
  subject        String
  initialMessage String        @map("initial_message")
  status         ContactStatus @default(NOUVEAU)
  createdAt      DateTime      @default(now()) @map("created_at")
  deletedAt      DateTime?     @map("deleted_at")

  messages          Message[]
  requestedServices RequestService[]

  @@map("contact")
}

model Message {
  id          String   @id @default(uuid()) @db.Uuid
  contactId   String   @db.Uuid @map("contact_id")
  messageText String   @map("message_text")
  senderEmail String   @map("sender_email")
  createdAt   DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("message")
}

model Image {
  id        String   @id @default(uuid()) @db.Uuid
  imageUrl  String   @map("image_url")
  altText   String?  @map("alt_text")
  createdAt DateTime @default(now()) @map("created_at")

  projectImages ProjectImage[]

  @@map("image")
}

model Client {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @unique @db.Uuid @map("user_id")
  name        String
  email       String
  phone       String?
  address     String?
  city        String?
  postalCode  String?   @map("postal_code")
  country     String?
  siret       String?   @unique
  companyName String?   @map("company_name")
  createdAt   DateTime  @default(now()) @map("created_at")
  deletedAt   DateTime? @map("deleted_at")

  user     User      @relation(fields: [userId], references: [id])
  invoices Invoice[]

  @@map("client")
}

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  invoiceNumber String        @unique @map("invoice_number")
  clientId      String        @db.Uuid @map("client_id")
  totalAmount   Decimal       @db.Decimal(10, 2) @map("total_amount")
  status        InvoiceStatus @default(DRAFT)
  createdAt     DateTime      @default(now()) @map("created_at")
  deletedAt     DateTime?     @map("deleted_at")

  client       Client        @relation(fields: [clientId], references: [id])
  invoiceItems InvoiceItem[]

  @@map("invoice")
}

model InvoiceItem {
  id        String   @id @default(uuid()) @db.Uuid
  invoiceId String   @db.Uuid @map("invoice_id")
  serviceId String   @db.Uuid @map("service_id")
  quantity  Decimal  @db.Decimal(10, 2)
  unitPrice Decimal  @db.Decimal(10, 2) @map("unit_price")
  subtotal  Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now()) @map("created_at")

  invoice Invoice @relation(fields: [invoiceId], references: [id])
  service Service @relation(fields: [serviceId], references: [id])

  @@map("invoice_item")
}

// ── Tables de jonction ────────────────────────────

model ProjectService {
  projectId String @db.Uuid @map("project_id")
  serviceId String @db.Uuid @map("service_id")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([projectId, serviceId])
  @@map("project_service")
}

model RequestService {
  contactId String @db.Uuid @map("contact_id")
  serviceId String @db.Uuid @map("service_id")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id], onDelete: Cascade)

  @@id([contactId, serviceId])
  @@map("request_service")
}

model ProjectImage {
  projectId String   @db.Uuid @map("project_id")
  imageId   String   @db.Uuid @map("image_id")
  isCover   Boolean  @default(false) @map("is_cover")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  image   Image   @relation(fields: [imageId], references: [id], onDelete: Cascade)

  @@id([projectId, imageId])
  @@map("project_image")
}